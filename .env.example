KSM_SECRET_KEY=
KASPIBOT_DATABASE=app.db
AI_PROVIDER=off
OLLAMA_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
KASPI_API_TOKEN=
KASPI_HISTORY_DAYS=14
# Explicitly opt in to legacy educational/calculated views only if needed.
KSM_DEMO_MODE=0

# Automatic read-only refresh at startup, then every 5 minutes.
KASPI_AUTO_SYNC=1
KASPI_SYNC_INTERVAL_SECONDS=300
# Direct HTTPS URL to YOUR continuously updated seller XML feed. Never commit it.
KASPI_CATALOG_URL=

# Local catalogue is opt-in; only localhost / 127.0.0.1 / [::1] on port 8443.
KASPI_ALLOW_LOCAL_CATALOG=0
# Relative to project root, or an absolute PEM CA path. Required for a private local CA.
KASPI_CATALOG_CA_BUNDLE=
# Local example: KASPI_CATALOG_URL=https://localhost:8443/catalog.xml
