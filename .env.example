KSM_SECRET_KEY=
KASPIBOT_DATABASE=app.db
AI_PROVIDER=off
OLLAMA_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
KASPI_API_TOKEN=
KASPI_HISTORY_DAYS=14
# Explicitly opt in to legacy educational/calculated views only if needed.
KSM_DEMO_MODE=0

# Independent durable read-only schedules; restarts respect saved deadlines.
KASPI_AUTO_SYNC=1
KASPI_SYNC_INTERVAL_SECONDS=300
KASPI_API_SYNC_INTERVAL_SECONDS=300
KASPI_XML_SYNC_INTERVAL_SECONDS=1800
KASPI_XML_MAX_BACKOFF_SECONDS=21600
# Direct HTTPS URL to YOUR continuously updated seller XML feed. Never commit it.
KASPI_CATALOG_URL=

# Local catalogue is opt-in; only localhost / 127.0.0.1 / [::1] on port 8443.
KASPI_ALLOW_LOCAL_CATALOG=0
# Relative to project root, or an absolute PEM CA path. Required for a private local CA.
KASPI_CATALOG_CA_BUNDLE=
# Local example: KASPI_CATALOG_URL=https://localhost:8443/catalog.xml

# Read-only cabinet XML exporter; requires one local login, no API token is used.
KASPI_CATALOG_EXPORT=0
KASPI_CATALOG_MERCHANT_ID=

# Browser default: chrome on Windows, bundled chromium on Linux.
# KASPI_CATALOG_BROWSER_CHANNEL=chromium
